# Quarto
/.quarto/
/_book/
/_freeze/

# Lixo que um render abortado deixa dentro de content/. O Quarto cria estes
# arquivos durante o render e os apaga no fim; se ele aborta (o bind mount do
# Docker no macOS às vezes falha com "Directory not empty"), eles ficam — e
# travam o render seguinte. O `make clean` os remove.
content/**/*.html
content/**/*_files/

# Python
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
**/*.quarto_ipynb*

# Ambiente
.env

# macOS
.DS_Store

# Editores
.vscode/

# Claude Code — preferências locais da máquina
.claude/settings.local.json

# Avaliações — material de prova/lista. O repositório é PÚBLICO; enunciados e
# gabarito NUNCA vão ao GitHub. O que se distribui é o PDF gerado localmente.
# (Mesmo princípio do arquivo de Rotinas, mantido local.)
/avaliacoes/

# Relatórios de auditoria (/humanize e afins) — locais, não versionados
quality_reports/

# Livros-fonte (epub/pdf). O repositório é PÚBLICO: material com direitos
# autorais fica local e NUNCA vai ao GitHub.
livros/

# Documentos administrativos da instituição — PID (plano individual docente,
# com dados do professor) e a grade de Rotinas, que é de terceiros. O
# repositório é PÚBLICO: ficam locais, como as avaliações e os livros-fonte.
/docs/PID*
/docs/ficha-PID.md
/docs/Rotinas*

**/*.quarto_ipynb

# Decisões respondidas pelo professor (documento de trabalho, local)
docs/decisoes-*.md

# baixado pelo notebook quando ele roda local (o original fica na raiz)
notebooks/formato.py
